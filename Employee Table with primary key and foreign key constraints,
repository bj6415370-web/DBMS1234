-- ALTER TABLE OPERATIONS
---------------------------------------------------

-- Add New Column
ALTER TABLE Employee
ADD Email VARCHAR(100);

-- Display Structure After ADD
DESC Employee;

-- Modify Column Datatype
ALTER TABLE Employee
MODIFY Emp_Name VARCHAR(100);

-- Display Structure After MODIFY
DESC Employee;

