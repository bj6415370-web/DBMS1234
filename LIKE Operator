-- Display Table
SELECT * FROM Employee;

-- Names Starting with 'A'
SELECT * FROM Employee
WHERE Emp_Name LIKE 'A%';

-- Names Ending with 'a'
SELECT * FROM Employee
WHERE Emp_Name LIKE '%a';

-- Names Containing 'h'
SELECT * FROM Employee
WHERE Emp_Name LIKE '%h%';

-- Names Having Second Letter 'r'
SELECT * FROM Employee
WHERE Emp_Name LIKE '_r%';

-- Department Starting with 'F'
SELECT * FROM Employee
WHERE Department LIKE 'F%';

-- Department Ending with 'T'
SELECT * FROM Employee
WHERE Department LIKE '%T';
