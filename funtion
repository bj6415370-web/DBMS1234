DELIMITER //

CREATE FUNCTION Annual_Salary(p_empid INT)
RETURNS INT
DETERMINISTIC
BEGIN
    DECLARE v_salary INT;

    SELECT Salary * 12
    INTO v_salary
    FROM Employee
    WHERE Emp_ID = p_empid;

    RETURN v_salary;
END //

DELIMITER ;



SELECT Annual_Salary(2) AS Annual_Salary;

