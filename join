-- inner join

SELECT 
    E.Emp_ID,
    E.Emp_Name,
    E.Department,
    D.Location
FROM Employee E
INNER JOIN Department D
ON E.Department = D.Dept_Name;

-- left join

SELECT 
    E.Emp_Name,
    E.Department,
    D.Location
FROM Employee E
LEFT JOIN Department D
ON E.Department = D.Dept_Name;
