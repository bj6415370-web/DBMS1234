DELIMITER //

CREATE PROCEDURE Increase_Salary(
    IN p_empid INT,
    IN p_amount INT
)
BEGIN
    UPDATE Employee
    SET Salary = Salary + p_amount
    WHERE Emp_ID = p_empid;
END //

DELIMITER ;



CALL Increase_Salary(2, 5000);


SELECT * FROM Employee WHERE Emp_ID = 2;


CALL Increase_Salary(4, 3000);



